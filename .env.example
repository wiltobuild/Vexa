DATABASE_URL=postgresql://vexa:vexa_local_only@127.0.0.1:5432/vexa
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://127.0.0.1:5173
API_PORT=3001
GATEWAY_PORT=3002
WORKER_ID=1
HOST=127.0.0.1
NODE_ENV=development
# Fastify trustProxy (default true): reads the client IP from X-Forwarded-For so the per-IP rate
# limiter doesn't bucket every user behind a reverse proxy/CDN (Vercel/Fly/Render/nginx) onto one
# shared limit. Set to "false" only when the API is reachable directly, with no proxy in front.
TRUST_PROXY=true
# /auth/register is rate-limited to 5/min by default (credential-stuffing/account-farming
# protection). Raise this only for a test harness that legitimately registers many accounts back
# to back (see apps/gateway/test/integration.test.ts, apps/web/e2e/connected.spec.ts) — never in
# a real deployment.
# AUTH_REGISTER_RATE_LIMIT_MAX=100

# Server-only. Enables private Whisper voice notes. Never put this in VITE_* variables.
OPENAI_API_KEY=

# Test harness only: combined integration suites share one IP. Default stays 120/min.
# API_RATE_LIMIT_MAX=1000
