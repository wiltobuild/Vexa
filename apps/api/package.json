{
  "name": "@vexa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@vexa/shared": "workspace:*",
    "fastify": "^5.2.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "pg": "^8.13.3",
    "ioredis": "^5.6.0",
    "zod": "^3.24.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  }
}
